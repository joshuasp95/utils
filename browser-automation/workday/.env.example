# URL de login de tu tenant Workday (la que abres en el navegador para entrar).
WORKDAY_URL=https://<HOST>.myworkday.com/wday/authgwy/<TENANT>/login.htmld
# Email corporativo con el que haces SSO.
WORKDAY_EMAIL=<USUARIO>@<EMPRESA>.com
# (Opcional) Contraseña para autorrellenar el login de Microsoft. Mejor dejarla vacía y teclearla a mano.
WORKDAY_PASSWORD=
# (Opcional) Carpeta del perfil persistente del navegador (por defecto ./.browser-session).
WORKDAY_USER_DATA_DIR=
# (Opcional) Ruta a un Chrome/Chromium concreto; vacío = el de `npx playwright install chromium`.
CHROMIUM_PATH=
