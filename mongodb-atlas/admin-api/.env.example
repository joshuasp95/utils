# MongoDB Atlas Admin API - Service Account (OAuth2 client_credentials)
# Copia este fichero a .env (cp .env.example .env) y rellena los valores reales.
# NUNCA subas .env al repositorio.

# Client ID del Service Account (Atlas UI → Organization/Project → Access Manager → Service Accounts)
ATLAS_CLIENT_ID=<ATLAS_CLIENT_ID>
# Client Secret del Service Account (solo se muestra al crearlo; si se pierde, generar otro)
ATLAS_CLIENT_SECRET=<ATLAS_CLIENT_SECRET>

# ID del proyecto de Atlas (en la API se llama groupId). Atlas UI → Project Settings → Project ID
ATLAS_PROJECT_ID=<ATLAS_PROJECT_ID>

# URL del endpoint OAuth2 que emite el token (opcional; los scripts traen un valor por defecto)
ATLAS_TOKEN_URL=https://cloud.mongodb.com/api/oauth/token
# URL base de la Admin API v2 (opcional; no modificar salvo entornos custom)
ATLAS_API_BASE=https://cloud.mongodb.com/api/atlas/v2
# Versión de la API que se pide en la cabecera Accept (opcional)
ATLAS_API_VERSION=2023-02-01
