# Application (client) ID de tu App registration en Entra ID (pública, permiso delegado Chat.Read).
TEAMS_EXPORT_CLIENT_ID=<CLIENT_ID>
# (Opcional) Directory (tenant) ID o dominio del tenant. Vacío = "organizations" (cualquier cuenta de trabajo).
TEAMS_EXPORT_TENANT_ID=
# (Opcional) Token delegado de Graph ya obtenido; si existe, no se usa device-code. No lo guardes en git.
GRAPH_ACCESS_TOKEN=
