# zshrc.example — esqueleto de ~/.zshrc que carga los ficheros de este repo en el orden correcto
#
# Cómo usarlo:  cp zshrc.example ~/.zshrc   (haz antes backup del tuyo: cp ~/.zshrc ~/.zshrc.bak)
#               y ajusta UTILS_REPO a donde clonaste el repo.
# Orden:        1) pre/*  → antes de Oh My Zsh (tema, plugins, fpath)
#               2) Oh My Zsh
#               3) resto  → historial, funciones, alias, completions, atajos
#               4) ~/.zshrc.local → lo específico de tu máquina o de tus proyectos (NO versionado)
#
# En ~/.zprofile (se lee una vez al iniciar sesión) basta con poner Homebrew en el PATH:
#   eval "$(/opt/homebrew/bin/brew shellenv)"      # Intel: /usr/local/bin/brew
# `brew shellenv` imprime los export de PATH, HOMEBREW_PREFIX…; eval los aplica a la shell.

export UTILS_REPO="${UTILS_REPO:-$HOME/utils}"   # ← AJUSTAR: ruta del repo clonado
_zsh_utils="$UTILS_REPO/shell/zsh"

# ── 1) Antes de Oh My Zsh ────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
for f in "$_zsh_utils"/pre/*.zsh(N); do source "$f"; done   # (N) = no falla si no hay ficheros

# ── 2) Oh My Zsh ─────────────────────────────────────────────────────────────
source "$ZSH/oh-my-zsh.sh"

# ── 3) Configuración común ───────────────────────────────────────────────────
source "$_zsh_utils/history.zsh"
source "$_zsh_utils/functions.zsh"   # antes que aliases: algunos alias llaman a funciones
source "$_zsh_utils/aliases.zsh"
source "$_zsh_utils/completions.zsh"
source "$_zsh_utils/bindkeys.zsh"

# PATH extra opcional (descomenta lo que uses):
# export PATH="$HOME/.krew/bin:$PATH"            # plugins de kubectl instalados con krew
# export PATH="/usr/local/mysql/bin:$PATH"       # cliente MySQL del instalador oficial
# export PATH="$PATH:$HOME/.lmstudio/bin"        # CLI de LM Studio

# ── 4) Local, sin versionar ──────────────────────────────────────────────────
# Alias de rutas de tus proyectos, tablas EKS_ENVS/AKS_ENVS, rutas de VPN corporativa, tokens…
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

unset _zsh_utils f
