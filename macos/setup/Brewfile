# 3. DATOS [OPCIONAL] — Kafka, MongoDB, Databricks
# ═════════════════════════════════════════════════════════════════════════════
brew "kafka"                                # Apache Kafka (incluye scripts kafka-topics, kafka-console-*)
brew "mongosh"                              # Shell de MongoDB
brew "mongodb-atlas-cli"                    # CLI de MongoDB Atlas (atlas)
brew "mongodb/brew/mongodb-community@8.0"   # Servidor MongoDB 8.0 local (pesado; solo si lo usas)
brew "databricks/tap/databricks", trusted: true  # CLI de Databricks

# ═════════════════════════════════════════════════════════════════════════════
# 4. LENGUAJES Y BUILD
# ═════════════════════════════════════════════════════════════════════════════
brew "nvm"              # Gestor de versiones de Node.js (las versiones las instala bootstrap.sh)
brew "node"             # Node.js "de sistema" (lo usan algunas fórmulas; para proyectos usa nvm)
brew "openjdk@21"       # JDK 21 (dependencia de maven/kafka; para proyectos usa SDKMAN)
brew "maven"            # Build de proyectos Java
brew "go"               # Lenguaje Go
brew "rust"             # Lenguaje Rust (rustc + cargo)
brew "graphviz"         # dot: genera diagramas a partir de texto

