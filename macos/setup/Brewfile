# Brewfile — lista de todo lo que Homebrew instala en el Mac de referencia
#
# Qué es:   un fichero que lee `brew bundle` para instalar de una vez taps, fórmulas (CLIs),
#           casks (apps con interfaz), extensiones de VS Code y algunos paquetes de otros gestores
#           (go, krew). Es idempotente: lo que ya está instalado se salta.
# Uso:      brew bundle --file=macos/setup/Brewfile           # instala lo que falte
#           brew bundle check --file=macos/setup/Brewfile     # solo dice si falta algo (no instala)
#           brew bundle list --file=macos/setup/Brewfile      # lista las entradas
# Generado: a partir de `brew bundle dump --describe` (snapshot 2026-10-05), reagrupado y comentado.
#           Explicación detallada: EXPLICACIONES.md#brewfile
#
# Grupos marcados [OPCIONAL]: coméntalos (pon `#` delante) si no los necesitas en el Mac nuevo.
# `trusted: true` = Homebrew 7 pide confirmar los taps de terceros; esta opción marca el tap
# como de confianza para que `brew bundle` no se pare a preguntar.

# ═════════════════════════════════════════════════════════════════════════════
# TAPS — repositorios extra de fórmulas (fuera del catálogo oficial de Homebrew)
# ═════════════════════════════════════════════════════════════════════════════
tap "anomalyco/tap"                                     # opencode (agente IA de terminal)
tap "aws/tap", trusted: true                            # eksctl (CLI de Amazon EKS)
tap "azure/kubelogin", "https://github.com/Azure/homebrew-kubelogin", trusted: true  # kubelogin
tap "confluentinc/tap", trusted: true                   # herramientas de Confluent (Kafka)
tap "databricks/tap", trusted: true                     # CLI de Databricks
tap "derailed/k9s", trusted: true                       # k9s (UI de terminal para Kubernetes)
tap "elastic/tap"                                       # ecctl (Elastic Cloud)
tap "hashicorp/tap", trusted: true                      # terraform oficial de HashiCorp
tap "kreuzwerker/taps"                                  # helper de providers Terraform para Apple Silicon
tap "localstack/tap", trusted: true                     # CLI de LocalStack (AWS simulado en local)
tap "mongodb/brew", trusted: true                       # servidor MongoDB Community

# ═════════════════════════════════════════════════════════════════════════════
# 1. CLI BÁSICO — utilidades de terminal del día a día
# ═════════════════════════════════════════════════════════════════════════════
brew "coreutils"        # Versiones GNU de ls, date, sort… (con prefijo g: gdate, gls)
brew "curl"             # Cliente HTTP/HTTPS/FTP (más nuevo que el de macOS)
brew "wget"             # Descargador de ficheros por HTTP/FTP
brew "git"              # Control de versiones (más nuevo que el de Xcode CLT)
brew "git-lfs"          # Extensión de git para ficheros grandes (Large File Storage)
brew "gh"               # CLI oficial de GitHub (PRs, issues, Actions)
brew "glab"             # CLI de GitLab (MRs, pipelines)
brew "jq"               # Procesador de JSON en línea de comandos
brew "yq"               # Como jq pero para YAML/JSON/XML/CSV
brew "ripgrep"          # rg: búsqueda de texto muy rápida (sustituto de grep -R)
brew "fd"               # Búsqueda de ficheros rápida (sustituto de find)
brew "fzf"              # Buscador difuso interactivo (Ctrl+R en el historial, pickers)
brew "bat"              # cat con resaltado de sintaxis e integración con git
brew "eza"              # Sustituto moderno de ls (colores, árbol, git)
brew "tree"             # Muestra directorios en forma de árbol
brew "watch"            # Repite un comando cada N segundos a pantalla completa
brew "gnu-time"         # gtime: mide tiempo y memoria de un comando (alias `clock`)
brew "htop"             # Monitor de procesos interactivo
brew "btop"             # Monitor de recursos (CPU, RAM, red, disco) más visual
brew "ncdu"             # Analizador de uso de disco en terminal
brew "httpie"           # Cliente HTTP amigable (http GET url)
brew "glow"             # Renderiza Markdown en la terminal
brew "neovim"           # Editor nvim (config en editors/nvim/ de este repo)
brew "telnet"           # Cliente telnet (útil para probar si un puerto TCP responde)
brew "duti"             # Define apps por defecto para extensiones/URLs desde terminal
brew "shellcheck"       # Linter de scripts bash/sh
brew "shfmt"            # Formateador de scripts de shell
brew "yamllint"         # Linter de YAML
brew "rtk"              # Proxy de CLI que reduce la salida para agentes IA (ahorro de tokens)

# ═════════════════════════════════════════════════════════════════════════════
# 2. CLOUD, KUBERNETES E INFRAESTRUCTURA COMO CÓDIGO
# ═════════════════════════════════════════════════════════════════════════════
# --- Nubes ---
brew "awscli"                           # CLI oficial de AWS
brew "aws/tap/eksctl"                   # CLI oficial de Amazon EKS (crear/gestionar clusters)
brew "azure-cli"                        # CLI de Azure (az)
brew "azure/kubelogin/kubelogin"        # Plugin de credenciales de kubectl para Azure (AKS + Entra ID)
brew "elastic/tap/ecctl"                # CLI oficial de Elastic Cloud
# --- Contenedores y Kubernetes ---
brew "docker"                           # Cliente docker (el motor lo da Docker Desktop, ver casks)
brew "kubernetes-cli"                   # kubectl
brew "helm"                             # Gestor de paquetes (charts) de Kubernetes
brew "kustomize"                        # Personaliza manifiestos YAML de Kubernetes sin plantillas
brew "krew"                             # Gestor de plugins de kubectl
brew "derailed/k9s/k9s"                 # UI de terminal para gestionar clusters
brew "kind"                             # Cluster de Kubernetes local dentro de Docker
brew "minikube"                         # Otro cluster de Kubernetes local
brew "argocd"                           # CLI de Argo CD (GitOps)
brew "openshift-cli"                    # oc: CLI de OpenShift (compatible con kubectl)
brew "hadolint"                         # Linter de Dockerfiles
brew "cosign"                           # Firma y verificación de imágenes de contenedor
# --- Terraform y secretos ---
brew "hashicorp/tap/terraform"          # Terraform (tap oficial de HashiCorp)
brew "terragrunt"                       # Envoltorio de Terraform (DRY, gestión de estados)
brew "tflint"                           # Linter de ficheros Terraform
brew "kreuzwerker/taps/m1-terraform-provider-helper"  # Compila providers Terraform antiguos sin binario arm64
brew "sops"                             # Edita ficheros cifrados (secretos en YAML/JSON)
brew "keeper-commander"                 # CLI del gestor de contraseñas Keeper
brew "oath-toolkit"                     # oathtool: genera códigos TOTP (2FA) desde terminal
# --- Simulación local ---
brew "localstack/tap/localstack-cli"    # CLI de LocalStack (AWS simulado en Docker). Nota: marcada
                                        # como obsoleta por su autor en favor de `lstk`

